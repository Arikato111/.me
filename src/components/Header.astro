---
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { SITE } from "@consts";
---

<header transition:persist class="animate">
  <Container>
    <div class="flex flex-wrap items-center justify-between gap-y-4">
      <Link href="/" underline={false} class="group">
        <div class="font-bold text-xl tracking-tighter text-neutral-900 dark:text-neutral-50 transition-colors group-hover:text-primary dark:group-hover:text-primary-dark">
          {SITE.TITLE}&nbsp;<span class="inline-block transition-transform group-hover:rotate-12 group-hover:scale-110">🔬</span>
        </div>
      </Link>
      
      <nav class="flex items-center gap-2 sm:gap-4 font-medium">
        <div class="flex items-center gap-1 sm:gap-2">
          <Link href="/blog" class="px-2 py-1 hover:text-primary dark:hover:text-primary-dark transition-colors">blog</Link>
          <span class="text-neutral-300 dark:text-neutral-700">/</span>
          <Link href="/tags" class="px-2 py-1 hover:text-primary dark:hover:text-primary-dark transition-colors">tags</Link>
          <span class="text-neutral-300 dark:text-neutral-700">/</span>
          <Link href="/projects" class="px-2 py-1 hover:text-primary dark:hover:text-primary-dark transition-colors">projects</Link>
        </div>

        <button
          id="magnifying-glass"
          aria-label="Search"
          class="flex items-center justify-center rounded-full size-10 bg-neutral-100 dark:bg-neutral-900 text-neutral-600 dark:text-neutral-400 hover:bg-primary/10 hover:text-primary transition-all duration-300 border border-transparent hover:border-primary/20"
        >
          <svg
            height="18"
            stroke-linejoin="round"
            viewBox="0 0 16 16"
            width="18"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            class="transition-transform group-hover:scale-110"
          >
            <circle cx="7" cy="7" r="5" />
            <path d="M11 11L15 15" stroke-linecap="round" />
          </svg>
        </button>
      </nav>
    </div>
  </Container>
</header>

---
import type { CollectionEntry } from "astro:content";

type Props = {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects">;
};

const { entry } = Astro.props as {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects">;
};
---

<a
  href={`/${entry.collection}/${entry.id}`}
  class="not-prose group relative flex flex-nowrap rounded-xl border border-neutral-200/50 bg-white/50 dark:border-neutral-800/50 dark:bg-neutral-900/50 px-5 py-4 transition-all duration-300 ease-out hover:border-primary/50 hover:bg-white dark:hover:bg-neutral-900 shadow-sm hover:shadow-md"
>
  <div class="flex flex-1 flex-col truncate">
    <div class="font-bold text-neutral-900 dark:text-neutral-50 group-hover:text-primary transition-colors">
      {entry.data.title}
    </div>
    <div class="text-sm text-neutral-600 dark:text-neutral-400 mt-1">
      {entry.data.description}
    </div>
  </div>
  
  <div class="shrink-0 self-center ml-4">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      class="size-5 fill-none stroke-neutral-400 group-hover:stroke-primary transition-colors duration-300 stroke-2"
    >
      <line
        x1="5"
        y1="12"
        x2="19"
        y2="12"
        class="translate-x-3 scale-x-0 transition-transform duration-300 ease-out group-hover:translate-x-0 group-hover:scale-x-100"
      ></line>
      <polyline
        points="12 5 19 12 12 19"
        class="-translate-x-1 transition-transform duration-300 ease-out group-hover:translate-x-0"
      ></polyline>
    </svg>
  </div>
</a>
